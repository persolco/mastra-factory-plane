{
  "name": "mastra-factory-plane",
  "version": "0.1.0",
  "description": "Plane integration for Mastra Factory: gives Factory agents Plane tools through the official plane-mcp-server.",
  "type": "module",
  "license": "MIT",
  "author": "Siamak Salman <siamak.salman71@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/persolco/mastra-factory-plane.git"
  },
  "homepage": "https://github.com/persolco/mastra-factory-plane#readme",
  "bugs": "https://github.com/persolco/mastra-factory-plane/issues",
  "keywords": ["mastra", "mastra-factory", "plane", "mcp", "integration"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "peerDependencies": {
    "@mastra/factory": ">=0.17.0",
    "@mastra/mcp": ">=2.1.0 <3"
  },
  "devDependencies": {
    "@mastra/factory": "0.17.2",
    "@mastra/mcp": "2.1.0",
    "@types/node": "22.20.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
